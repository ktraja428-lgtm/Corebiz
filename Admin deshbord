<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CoreBiz - Admin</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body { background:#0F172A; color:#fff; font-family:system-ui,sans-serif; padding:20px; }
h1 { color:#F59E0B; font-size:22px; margin-bottom:4px; }
.sub { color:#94A3B8; font-size:13px; margin-bottom:20px; }
.stat { background:#1E293B; border-radius:14px; padding:16px; margin-bottom:20px; text-align:center; }
.stat b { font-size:28px; color:#34D399; display:block; }
table { width:100%; border-collapse:collapse; font-size:13px; }
th, td { text-align:left; padding:10px 6px; border-bottom:1px solid #334155; }
th { color:#94A3B8; font-weight:600; }
.loading { text-align:center; color:#94A3B8; padding:40px; }
.denied { text-align:center; color:#FCA5A5; padding:60px 20px; }
</style>
</head>
<body>

<div id="content" class="loading">Loading...</div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.15.0/firebase-app.js";
  import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/12.15.0/firebase-auth.js";
  import { getFirestore, collectionGroup, getDocs } from "https://www.gstatic.com/firebasejs/12.15.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyDJRsJMU-jfy2iQoZsCVZGmyMT-l9mEMf8",
    authDomain: "corebiz-f7762.firebaseapp.com",
    projectId: "corebiz-f7762",
    storageBucket: "corebiz-f7762.firebasestorage.app",
    messagingSenderId: "928975624139",
    appId: "1:928975624139:web:c24e248984883a3a3O484e",
    measurementId: "G-33FSED87HM"
  };

  const ADMIN_EMAIL = "ktraja428@gmail.com"; // <-- YE APNA SAHI OWNER EMAIL DAALO

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);
  const content = document.getElementById('content');

  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      window.location.href = 'login.html';
      return;
    }
    if (user.email !== ADMIN_EMAIL) {
      content.className = 'denied';
      content.innerHTML = 'Ye page sirf owner ke liye hai.';
      return;
    }

    try {
      const snap = await getDocs(collectionGroup(db, 'profile'));
      let rows = '';
      let count = 0;
      snap.forEach(doc => {
        const d = doc.data();
        if (d.businessName) {
          count++;
          const date = d.createdAt ? new Date(d.createdAt).toLocaleDateString('en-IN') : '-';
          rows += `<tr>
            <td>${d.businessName || '-'}</td>
            <td>${d.email || '-'}</td>
            <td>${d.phone || '-'}</td>
            <td>${date}</td>
          </tr>`;
        }
      });

      content.className = '';
      content.innerHTML = `
        <h1>Admin Dashboard</h1>
        <div class="sub">Saare registered businesses</div>
        <div class="stat"><b>${count}</b>Total Businesses</div>
        <table>
          <tr><th>Business</th><th>Email</th><th>Phone</th><th>Signup</th></tr>
          ${rows || '<tr><td colspan="4">Koi data nahi mila</td></tr>'}
        </table>
      `;
    } catch (err) {
      content.innerHTML = 'Error: ' + err.message;
    }
  });
</script>
</body>
</html>
